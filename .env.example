# Copy to .env. Every value is optional: with NO keys the planner runs in rule-based mode.
# Never commit .env.

# --- LLM providers (free tiers, no card). Verify current limits in each console before relying on them.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional offline model: install Ollama, pull a model, then set OLLAMA_ENABLED=1
OLLAMA_ENABLED=0
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Behaviour
ENGINE=auto            # auto | langgraph | runner
TOOLS_MODE=inprocess   # inprocess | mcp
REAL_DATA=1            # 1 = Open-Meteo / OSM / Wikivoyage (falls back offline), 0 = offline only
TRIP_DB=travel_planner.db   # a plain file name is kept in the .runtime/ folder; a full path is used as it is
TRACE_FILE=traces.jsonl     # one JSON line per run (time, tool and LLM counts), also in .runtime/; 'off' disables

# --- Web API
AUTH_REQUIRED=0        # 1 = only signed-in users can plan
RATE_LIMIT=1           # 0 = no rate limits (more settings are listed in docs/features.md)

# --- Live fares and hotel prices (optional). Bright Data SERP API: free tier, no card. Without these the planner
# keeps using clearly labelled ESTIMATES. Create an account at brightdata.com, add a "SERP API" zone, copy its
# name and your API key here. Never commit .env.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
# Tavily (search + page extract for agents): free tier of 1,000 credits a month, no card. Create a key at
# app.tavily.com (it starts with tvly-). You can set either provider or both; the probe tests whichever has keys.
TAVILY_API_KEY=
# Live prices need TAVILY_API_KEY and REAL_DATA=1. Each page read costs 2 Tavily credits (flights + hotels = 4 per
# plan); pages are cached, and the daily cap stops the free plan (1,000 credits a month) from running out.
LIVE_PRICES=1          # 0 = always use the clearly labelled estimates
LIVE_DAILY_CREDITS=30  # most Tavily credits the planner may spend per day
LIVE_CACHE_HOURS=3     # how long a fetched price page is reused (0 = never)
