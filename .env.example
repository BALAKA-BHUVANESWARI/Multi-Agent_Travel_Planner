# Copy to .env. Every value is optional: with NO keys the planner runs in rule-based mode.
# Never commit .env.

# --- LLM providers (free tiers, no card). Verify current limits in each console before relying on them.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional offline model: install Ollama, pull a model, then set OLLAMA_ENABLED=1
OLLAMA_ENABLED=0
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Behaviour
ENGINE=auto            # auto | langgraph | runner
TOOLS_MODE=inprocess   # inprocess | mcp
REAL_DATA=1            # 1 = Open-Meteo / OSM / Wikivoyage (falls back offline), 0 = offline only
TRIP_DB=travel_planner.db
TRACE_FILE=traces.jsonl  # one JSON line per run (time, tool and LLM counts); 'off' disables
